<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_sim</name>
  <version>0.1.0</version>
  <description>Mo phong Gazebo (chay tren PC, KHONG chay tren Pi 4): FC gia theo giao uoc, cau MAVROS, thu dap ung buoc de tune vong vi tri.</description>
  <maintainer email="phamvanchinh203@gmail.com">pc</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>drone_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>
  <exec_depend>drone_bringup</exec_depend>
  <exec_depend>drone_control</exec_depend>
  <exec_depend>drone_mission</exec_depend>
  <exec_depend>drone_estimation</exec_depend>
  <exec_depend>drone_safety</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
