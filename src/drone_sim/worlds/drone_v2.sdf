<?xml version="1.0" ?>
<!--
  The gioi mo phong nhiem vu voi KHUNG Version2.0 (drone_v2) - giong het drone_tune.sdf (den, mat dat,
  bai co anh AprilTag that) nhung thay X3 bang models/drone_v2 sinh tu drone_v2.urdf, co servo camera
  that va hop hang o bai A. Ten world giu "drone_tune" de moi lenh gz service / bridge dung chung.
  plugin MulticopterVelocityControl dong vong van toc, dong vai FC o che do OFFBOARD van toc.
  Lenh /X3/gazebo/command/twist theo KHUNG THAN (x toi, y trai, z len) - cung quy uoc FLU cua
  position_controller_node. Can GZ_SIM_RESOURCE_PATH chua thu muc models (sim_launch tu dat).
-->
<sdf version="1.9" xmlns:experimental="http://sdformat.org/schemas/experimental">
  <world name="drone_tune">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Anh sang troi tan xa manh (ambient) -> bong drone NHAT nhu ngoai troi that (user 10-09: bong
         hau nhu khong anh huong khi bay that); mat troi giam theo cho mat dat khong chay trang. -->
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mat dat co van (tools/sim_ground_texture.py) phu vung bay 24 x 24 m quanh cac bai: mat
         phang xam tron khong co goc nao cho optical flow bam. Chi de nhin/camera - va cham van la
         ground_plane. -->
    <model name="ground_texture">
      <static>true</static>
      <pose>5 -3 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 24</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/ground.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bai dap pad_home: tag 0, khop config/sim_tags.yaml (anh AprilTag that: chi tag to 25 cm giua to A3 nhu to in GCS tu 10-22, yaw model = huong bai ENU) -->
    <model name="pad_home">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <!-- To A3 trang (GCS "In bai dap A3" tu 10-22: chi tag to, giua trang), doc theo huong bai.
               Tag to co vien trang 31 mm rong hon kho 297 mm - nhu to in that, GCS cung canh bao. -->
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.42 0.297 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="tag_to">
          <!-- canh khoi den 0.25 m (apriltag.yaml) + vien trang 1 o = 0.3125 m. Yaw -90 do: mep
               TREN anh (truc +y cua mat phang) quay ve +x model = phia "tren" bai. -->
          <pose>0 0 0.0055 0 0 -1.5708</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.3125 0.3125</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/tag36h11_00.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bai dap pad_a: tag 1, khop config/sim_tags.yaml (anh AprilTag that: chi tag to 25 cm giua to A3 nhu to in GCS tu 10-22, yaw model = huong bai ENU) -->
    <model name="pad_a">
      <static>true</static>
      <pose>10 0 0.005 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <!-- To A3 trang (GCS "In bai dap A3" tu 10-22: chi tag to, giua trang), doc theo huong bai.
               Tag to co vien trang 31 mm rong hon kho 297 mm - nhu to in that, GCS cung canh bao. -->
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.42 0.297 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="tag_to">
          <!-- canh khoi den 0.25 m (apriltag.yaml) + vien trang 1 o = 0.3125 m. Yaw -90 do: mep
               TREN anh (truc +y cua mat phang) quay ve +x model = phia "tren" bai. -->
          <pose>0 0 0.0055 0 0 -1.5708</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.3125 0.3125</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/tag36h11_01.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bai dap pad_b: tag 2, khop config/sim_tags.yaml (anh AprilTag that: chi tag to 25 cm giua to A3 nhu to in GCS tu 10-22, yaw model = huong bai ENU) -->
    <model name="pad_b">
      <static>true</static>
      <pose>5 -6 0.005 0 0 -1.5708</pose>
      <link name="link">
        <visual name="visual">
          <!-- To A3 trang (GCS "In bai dap A3" tu 10-22: chi tag to, giua trang), doc theo huong bai.
               Tag to co vien trang 31 mm rong hon kho 297 mm - nhu to in that, GCS cung canh bao. -->
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.42 0.297 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="tag_to">
          <!-- canh khoi den 0.25 m (apriltag.yaml) + vien trang 1 o = 0.3125 m. Yaw -90 do: mep
               TREN anh (truc +y cua mat phang) quay ve +x model = phia "tren" bai. -->
          <pose>0 0 0.0055 0 0 -1.5708</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.3125 0.3125</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/tag36h11_02.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone khung Version2.0 (models/drone_v2, sinh tu drone_v2.urdf). Dat cho chan (0,155 m duoi
         mat FC = goc base_link) cham dat. Topic giu ten X3 (robotNamespace, odometry) de moi node Pi va
         sim_fc_bridge dung y nhu world X3. Hang so dong co/gain lay cua X3: gain cua
         MulticopterVelocityControl da chuan hoa theo quan tinh nen dung lai duoc; luc day toi da
         4 x 8,55e-6 x 800^2 = 21,9 N so voi trong luong 7,5 N (khoi luong CAD 0,768 kg - CHUA CAN). -->
    <include>
      <uri>model://drone_v2</uri>
      <name>drone_v2</name>
      <pose>0 0 0.156 0 0 0</pose>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>prop_front_left_joint</jointName>
        <linkName>prop_front_left</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>prop_front_right_joint</jointName>
        <linkName>prop_front_right</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>prop_rear_left_joint</jointName>
        <linkName>prop_rear_left</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>prop_rear_right_joint</jointName>
        <linkName>prop_rear_right</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-control-system"
        name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>X3</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>

        <rotorConfiguration>
          <rotor>
            <jointName>prop_front_left_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>prop_front_right_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>prop_rear_left_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>prop_rear_right_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_topic>/model/X3/odometry</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
      <!-- Servo camera: goc (rad) tu sim_fc_bridge_node khi FC gia nhan lenh 183 servo 2 (bang xung ->
           goc cua mission.yaml). Lenh van toc thay luc: link camera chi 9 g, PID luc o buoc 4 ms mat
           on dinh. Toc do toi da 10,5 rad/s = ES08MD II 0,10 s/60 do (URDF). -->
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>camera_tilt_joint</joint_name>
        <topic>/X3/camera_tilt/cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>20</p_gain>
        <cmd_max>10.5</cmd_max>
        <cmd_min>-10.5</cmd_min>
      </plugin>
      <!-- Camera OV9281 tai TAM ONG KINH tren camera_tilt_link (mesh: day ong kinh 14 x 14 mm o
           (0, 0,017, -0,0418) m), nhin theo -Z cua link (pitch 90 do: truc nhin +X cua sensor -> -Z), mep
           tren anh = mui o goc 0. Quay theo servo nen anh nghieng that. K that (camera_info Pi 5). -->
      <experimental:params>
        <sensor element_id="camera_tilt_link" action="add" name="camera_down" type="camera">
          <pose>0 0.017 -0.0418 0 1.5708 0</pose>
          <gz_frame_id>camera_optical_frame</gz_frame_id>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <topic>/camera/image_raw</topic>
          <camera>
            <camera_info_topic>/camera/camera_info</camera_info_topic>
            <horizontal_fov>1.6355</horizontal_fov>
            <image><width>640</width><height>400</height><format>L8</format></image>
            <clip><near>0.02</near><far>40</far></clip>
            <lens>
              <intrinsics>
                <fx>299.939</fx><fy>298.752</fy><cx>321.575</cx><cy>180.207</cy><s>0</s>
              </intrinsics>
            </lens>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </camera>
        </sensor>
      </experimental:params>
    </include>
    <!-- Hop hang 12 x 12 x 12 cm tai bai A (tag 1): tag nho id 11 (10 cm + vien trang 1 o) dan tren nap,
         CUNG huong tag to cua bai; tam hop cach tam tag to 0,30 m ve phia "duoi" (config/sim_tags.yaml).
         Khong co va cham: drone treo gap ngay tren hop, khung va cham cua than (hop bao) se chong len. -->
    <model name="hop_a">
      <static>true</static>
      <pose>10 -0.3 0 0 0 1.5708</pose>
      <link name="link">
        <visual name="hop">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <visual name="tag_hop">
          <pose>0 0 0.1205 0 0 -1.5708</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.125 0.125</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/tag36h11_11.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <!-- Hop hang 12 x 12 x 12 cm tai bai B (tag 2): tag nho id 12 (10 cm + vien trang 1 o) dan tren nap,
         CUNG huong tag to cua bai; tam hop cach tam tag to 0,30 m ve phia "duoi" (config/sim_tags.yaml).
         Khong co va cham: drone treo gap ngay tren hop, khung va cham cua than (hop bao) se chong len. -->
    <model name="hop_b">
      <static>true</static>
      <pose>5 -5.7 0 0 0 -1.5708</pose>
      <link name="link">
        <visual name="hop">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        <visual name="tag_hop">
          <pose>0 0 0.1205 0 0 -1.5708</pose>
          <geometry><plane><normal>0 0 1</normal><size>0.125 0.125</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
            <pbr><metal><albedo_map>textures/tag36h11_12.png</albedo_map>
              <roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
