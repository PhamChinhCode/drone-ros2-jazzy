        <mxCell id="d_warn" value="&lt;b&gt;⚠ ĐIỂM CẦN BẠN XEM LẠI — HAI NODE CÙNG PUBLISH MỘT TOPIC ĐIỀU KHIỂN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;position_controller_node&lt;/b&gt; (position_controller_node.py:57) và &lt;b&gt;fc_command_bridge_node&lt;/b&gt; (fc_command_bridge_node.py:42)&lt;br&gt;&lt;b&gt;cùng publish PositionTarget lên /mavros/setpoint_raw/local&lt;/b&gt; (2 đường đỏ đậm trong sơ đồ).&lt;br&gt;&lt;br&gt;ROS 2 không phân xử — FC nhận xen kẽ cả hai luồng theo thứ tự tới. Nếu cả hai cùng chạy timer&lt;br&gt;(control_rate_hz và setpoint_rate_hz), lệnh sẽ giằng nhau. Cần đảm bảo tại mỗi thời điểm chỉ MỘT&lt;br&gt;node thật sự phát (mission_manager chọn chế độ), hoặc gộp về một điểm phát duy nhất." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="900" height="150" as="geometry" />
        </mxCell>

        <mxCell id="d_key" value="&lt;b&gt;ĐỌC SƠ ĐỒ NÀY THEO 3 VÒNG LẶP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Vòng cảm nhận → ước lượng&lt;/b&gt; (nhanh, ~60 Hz)&lt;br&gt;camera → rectify → apriltag → EKF → /odometry/filtered&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Vòng điều khiển&lt;/b&gt;&lt;br&gt;/odometry/filtered + /mission/setpoint → position_controller&lt;br&gt;→ /mavros/setpoint_raw/local → FC&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Vòng nhiệm vụ / an toàn&lt;/b&gt; (chậm, theo sự kiện)&lt;br&gt;GCS → /mission/plan → mission_manager → service tới&lt;br&gt;fc_command_bridge; failsafe_monitor có quyền cắt ngang&lt;br&gt;bằng service simple_command (RTL/LAND).&lt;br&gt;&lt;br&gt;&lt;b&gt;mission_manager_node là trung tâm&lt;/b&gt; — 8 subscription,&lt;br&gt;4 publisher, 4 service client. Muốn hiểu hệ thống, đọc&lt;br&gt;máy trạng thái của node này trước." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="870" width="470" height="300" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
