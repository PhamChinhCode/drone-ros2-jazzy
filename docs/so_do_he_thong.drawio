<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17" type="device">
  <diagram id="page-boot" name="1. Trình tự khởi động (boot)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="b_title" value="&lt;b&gt;QUÁ TRÌNH KHỞI ĐỘNG THỰC TẾ&lt;/b&gt;&lt;br&gt;(những gì thật sự xảy ra khi cắm điện Pi 4)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_pwr" value="Bật nguồn Pi 4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_sysd" value="&lt;b&gt;systemd&lt;/b&gt;&lt;br&gt;After=multi-user.target, network-online.target" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_svc" value="&lt;b&gt;drone-startup.service&lt;/b&gt; &lt;i&gt;(enabled, active)&lt;/i&gt;&lt;br&gt;/etc/systemd/system/drone-startup.service&lt;br&gt;Type=oneshot · RemainAfterExit=yes&lt;br&gt;User=pc · SupplementaryGroups=video" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="240" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b_bg" value="&lt;b&gt;/home/pc/ros2_ws/scripts/drone_startup.sh&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="800" height="440" as="geometry" />
        </mxCell>

        <mxCell id="b_m1" value="&lt;b&gt;MỤC 1 — Cấu hình V4L2 cho camera&lt;/b&gt; &lt;i&gt;(bị RESET mỗi lần reboot ⇒ phải chạy lại)&lt;/i&gt;&lt;br&gt;• Vòng chờ tối đa 30 s cho udev tạo /dev/media* có entity &lt;i&gt;ov9281&lt;/i&gt;&lt;br&gt;&#160;&#160;(không dùng After=dev-video0.device được vì /dev/video0 không có TAG systemd)&lt;br&gt;• camera_v4l2_setup.sh → 640×400, Y8_1X8, vblank=1779 (60 FPS), exposure=400, gain=60&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;✗ Bỏ qua bước này ⇒ mọi khung hình TOÀN SỐ 0 mà `ros2 topic hz` vẫn báo đúng nhịp&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="400" width="740" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b_m2" value="&lt;b&gt;MỤC 2 — Nạp môi trường ROS 2&lt;/b&gt;&lt;br&gt;source /opt/ros/jazzy/setup.bash&#160;&#160;→&#160;&#160;source /home/pc/ros2_ws/install/setup.bash&lt;br&gt;&lt;i&gt;Khi chạy từ systemd, môi trường này CHỈ tồn tại bên trong script — không lan ra hệ thống.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="540" width="740" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b_m3" value="&lt;b&gt;MỤC 3 — ĐANG ĐỂ TRỐNG&lt;/b&gt;&lt;br&gt;⇒ &lt;b&gt;KHÔNG một node ROS nào được khởi động lúc boot&lt;/b&gt; — kể cả foxglove_bridge.&lt;br&gt;Log boot xác nhận: &lt;i&gt;&quot;[3/3] Xong. Chưa có lệnh nào ở MỤC 3.&quot;&lt;/i&gt;&lt;br&gt;Script thoát (status 0) ⇒ service ở trạng thái &lt;i&gt;active (exited)&lt;/i&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="640" width="740" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b_todo" value="&lt;b&gt;ĐỂ HỆ THỐNG TỰ CHẠY LÚC BOOT — cần 2 thay đổi, không phải 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Thêm vào MỤC 3:&#160;&#160;&lt;i&gt;ros2 launch drone_bringup full_system.launch.py&lt;/i&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Sửa unit: &lt;i&gt;Type=oneshot + RemainAfterExit=yes&lt;/i&gt; → &lt;i&gt;Type=simple&lt;/i&gt;, bỏ comment &lt;i&gt;KillSignal=SIGINT&lt;/i&gt; và &lt;i&gt;TimeoutStopSec=15&lt;/i&gt;&lt;br&gt;&#160;&#160;&#160;&#160;(vì `ros2 launch` chạy mãi không thoát — để oneshot thì systemd treo chờ)&lt;br&gt;&lt;br&gt;rồi: sudo systemctl daemon-reload &amp;&amp; sudo systemctl restart drone-startup.service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="840" width="740" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b_next" value="→ Xem trang &lt;b&gt;2. Cây launch&lt;/b&gt; để biết lệnh đó khởi động những node nào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="1010" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="b_pwr" target="b_sysd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="b_sysd" target="b_svc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e3" value="ExecStart" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_svc" target="b_m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="b_m1" target="b_m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" edge="1" parent="1" source="b_m2" target="b_m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="b_m3" target="b_todo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="b_todo" target="b_next"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-launch" name="2. Cây launch &amp; node theo giai đoạn">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l_title" value="&lt;b&gt;CÂY LAUNCH — node nào thuộc giai đoạn nào&lt;/b&gt;&lt;br&gt;Mũi tên = IncludeLaunchDescription (launch ngoài KÉO THEO toàn bộ launch trong)" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="660" height="50" as="geometry" />
        </mxCell>

        <mxCell id="l_s3" value="&lt;b&gt;full_system.launch.py&lt;/b&gt;&#160;&#160;— Giai đoạn 3–5: nhiệm vụ · GCS · an toàn · ghi log&lt;br&gt;&lt;br&gt;• fc_command_bridge_node&#160;&lt;i&gt;(drone_mission)&lt;/i&gt;&#160;← mission.yaml&lt;br&gt;• mission_manager_node&#160;&lt;i&gt;(drone_mission)&lt;/i&gt;&#160;← mission.yaml&lt;br&gt;• gripper_controller_node&#160;&lt;i&gt;(drone_mission)&lt;/i&gt;&#160;← mission.yaml&lt;br&gt;• telemetry_aggregator_node&#160;&lt;i&gt;(drone_comms)&lt;/i&gt;&#160;← comms.yaml&lt;br&gt;• gcs_link_node&#160;&lt;i&gt;(drone_comms)&lt;/i&gt;&#160;← comms.yaml&lt;br&gt;• failsafe_monitor_node&#160;&lt;i&gt;(drone_safety)&lt;/i&gt;&#160;← safety.yaml&lt;br&gt;• mission_logger_node&#160;&lt;i&gt;(drone_safety)&lt;/i&gt;&#160;← safety.yaml&lt;br&gt;• &lt;font color=&quot;#3333ff&quot;&gt;foxglove_bridge&#160;&lt;i&gt;(bên thứ 3)&lt;/i&gt;&#160;— port 8765, address 0.0.0.0&lt;/font&gt;&lt;br&gt;• ExecuteProcess: &lt;i&gt;ros2 bag record&lt;/i&gt; → ~/drone_logs/bag (9 topic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="620" height="220" as="geometry" />
        </mxCell>

        <mxCell id="l_s2" value="&lt;b&gt;control.launch.py&lt;/b&gt;&#160;&#160;— Giai đoạn 2: lớp điều khiển (hạ cánh chính xác)&lt;br&gt;&lt;br&gt;• landing_target_bridge_node&#160;&lt;i&gt;(drone_control)&lt;/i&gt;&#160;← control.yaml&lt;br&gt;• position_controller_node&#160;&lt;i&gt;(drone_control)&lt;/i&gt;&#160;← control.yaml&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;⚠ control.yaml đang để gain PID = 0.0 (cảnh báo trong docstring)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="620" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l_s1b" value="&lt;b&gt;estimation.launch.py&lt;/b&gt;&#160;&#160;— Giai đoạn 1b: MAVROS + EKF (position hold không trôi)&lt;br&gt;&lt;br&gt;• mavros&#160;&lt;i&gt;(bên thứ 3)&lt;/i&gt;&#160;← mavros.yaml&lt;br&gt;• base_to_camera&#160;&lt;i&gt;(tf2_ros static_transform_publisher)&lt;/i&gt;&#160;— base_link → camera_link&lt;br&gt;&#160;&#160;&#160;args: 0 0 -0.05&#160;&#160;0 1.5708 0&#160;&#160;&lt;font color=&quot;#b85450&quot;&gt;(PHẢI đo thật — sai ⇒ &quot;thấy đúng marker nhưng bay lệch tâm&quot;)&lt;/font&gt;&lt;br&gt;• marker_pose_republisher_node&#160;&lt;i&gt;(drone_estimation)&lt;/i&gt;&#160;← estimation.yaml&lt;br&gt;• ekf_filter_node&#160;&lt;i&gt;(robot_localization)&lt;/i&gt;&#160;← ekf.yaml&lt;br&gt;• ekf_health_node&#160;&lt;i&gt;(drone_estimation)&lt;/i&gt;&#160;← estimation.yaml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="620" height="170" as="geometry" />
        </mxCell>

        <mxCell id="l_s1a" value="&lt;b&gt;perception.launch.py&lt;/b&gt;&#160;&#160;— Giai đoạn 1a: camera → rectify → apriltag → chất lượng bám + optical flow&lt;br&gt;&lt;br&gt;• camera_node&#160;&lt;i&gt;(v4l2_camera, namespace=camera)&lt;/i&gt;&#160;← camera.yaml&lt;br&gt;• image_rectify&#160;&lt;i&gt;(image_proc, namespace=camera)&lt;/i&gt;&#160;— remap image→image_raw&lt;br&gt;• marker_detector_node&#160;&lt;i&gt;(apriltag_ros)&lt;/i&gt;&#160;← apriltag.yaml&lt;br&gt;• marker_quality_node&#160;&lt;i&gt;(drone_perception)&lt;/i&gt;&#160;← perception.yaml&lt;br&gt;• optical_flow_node&#160;&lt;i&gt;(drone_perception)&lt;/i&gt;&#160;← perception.yaml&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;⚠ PHỤ THUỘC NGOÀI ROS: camera_v4l2_setup.sh phải chạy TRƯỚC (MỤC 1 của drone_startup.sh)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="620" height="170" as="geometry" />
        </mxCell>

        <mxCell id="l_e1" value="include" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="l_s3" target="l_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l_e2" value="include" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="l_s2" target="l_s1b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l_e3" value="include" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="l_s1b" target="l_s1a"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="l_n1" value="&lt;b&gt;ĐIỂM DỄ HIỂU NHẦM NHẤT&lt;/b&gt;&lt;br&gt;&lt;br&gt;`ros2 launch` khởi động &lt;b&gt;tất cả tiến trình gần như ĐỒNG THỜI&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Thứ tự các Node trong danh sách &lt;b&gt;KHÔNG&lt;/b&gt; đảm bảo node nào&lt;br&gt;sẵn sàng trước node nào. Không có barrier, không có &quot;chờ&lt;br&gt;node kia lên xong&quot;.&lt;br&gt;&lt;br&gt;Các node tự đồng bộ bằng cách &lt;b&gt;chờ dữ liệu tới trên topic&lt;/b&gt;&lt;br&gt;(hoặc chờ service khả dụng). Vì vậy lúc mới bật, vài giây&lt;br&gt;đầu có WARN/log rỗng là bình thường.&lt;br&gt;&lt;br&gt;⇒ Sơ đồ &quot;thứ tự&quot; thật sự có ý nghĩa là &lt;b&gt;luồng dữ liệu&lt;/b&gt;&lt;br&gt;(trang 3), không phải thứ tự spawn tiến trình." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="70" width="420" height="260" as="geometry" />
        </mxCell>

        <mxCell id="l_n2" value="&lt;b&gt;THỨ TỰ KIỂM THỬ KHUYẾN NGHỊ&lt;/b&gt; &lt;i&gt;(theo docstring trong chính các launch file)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1a&lt;/b&gt; perception → verify:&lt;br&gt;&#160;&#160;• `ros2 topic hz /camera/image_raw` ≈ 60 Hz&lt;br&gt;&#160;&#160;• kiểm THỐNG KÊ PIXEL (std vài chục, max ~255) — hz KHÔNG bắt được ảnh toàn 0&lt;br&gt;&#160;&#160;• `/camera/camera_info` có k[0] ≠ 0 và d[] đủ 5 hệ số&lt;br&gt;&#160;&#160;• khoảng cách trong `/apriltag/detections` khớp thước đo tay (sai &amp;lt;5–10%)&lt;br&gt;&lt;br&gt;&lt;b&gt;1b&lt;/b&gt; estimation → verify: thêm từng nguồn một (IMU → optical flow → marker),&lt;br&gt;&#160;&#160;mỗi lần thêm kiểm `/odometry/filtered` không có bước nhảy đột ngột&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt; control → verify: tune PID trong Gazebo TRƯỚC khi bay thật&lt;br&gt;&lt;br&gt;&lt;b&gt;3–5&lt;/b&gt; full_system → verify: `/mission/state`, `/failsafe_event`, `/telemetry/outgoing`" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="420" height="290" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-dataflow" name="3. Luồng dữ liệu &amp; phụ thuộc node">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d_title" value="&lt;b&gt;LUỒNG DỮ LIỆU THẬT — ai phụ thuộc vào ai (trích từ create_subscription / create_publisher / create_client)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="d_lg" value="&lt;b&gt;Chú giải&lt;/b&gt;&#160;&#160;&#160;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; node tự viết (drone_*)&#160;&#160;&#160;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; node bên thứ 3&#160;&#160;&#160;&lt;font color=&quot;#666666&quot;&gt;■&lt;/font&gt; phần cứng / bên ngoài&#160;&#160;&#160;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; chỉ ĐỌC (quan sát/ghi log)&#160;&#160;&#160;— topic —▸&#160;&#160;&#160;- - service - -▸" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="45" width="1180" height="30" as="geometry" />
        </mxCell>

        <mxCell id="d_c1" value="CẢM NHẬN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="230" height="620" as="geometry" />
        </mxCell>
        <mxCell id="d_c2" value="ƯỚC LƯỢNG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="290" y="90" width="230" height="620" as="geometry" />
        </mxCell>
        <mxCell id="d_c3" value="ĐIỀU KHIỂN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="550" y="90" width="230" height="620" as="geometry" />
        </mxCell>
        <mxCell id="d_c4" value="MAVROS / FC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="810" y="90" width="230" height="620" as="geometry" />
        </mxCell>
        <mxCell id="d_c5" value="NHIỆM VỤ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1070" y="90" width="230" height="620" as="geometry" />
        </mxCell>
        <mxCell id="d_c6" value="AN TOÀN / GCS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;verticalAlign=top;fontSize=11;fontColor=#999999;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1330" y="90" width="230" height="620" as="geometry" />
        </mxCell>

        <mxCell id="hw_cam" value="/dev/video0&lt;br&gt;&lt;i&gt;OV9281 mono 640×400&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="190" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n_cam" value="&lt;b&gt;camera_node&lt;/b&gt;&lt;br&gt;&lt;i&gt;v4l2_camera · ns=camera&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="190" height="44" as="geometry" />
